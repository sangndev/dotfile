" -------------------------------------------------------------------
" Setting
" -------------------------------------------------------------------
let mapleader = " "
let maplocalleader = " "
let g:netrw_banner = 0

filetype plugin indent on
syntax on
set number
set relativenumber
set si
set noswapfile
set tabstop=2
set shiftwidth=2
set expandtab
set smarttab
set hlsearch
set incsearch
set ignorecase
set smartcase
set showmatch
set noerrorbells
set novisualbell
set encoding=utf8
set clipboard=unnamed
set noendofline
set shiftround
set nowrap
set colorcolumn=80
set cursorline
set laststatus=2
set splitbelow
set splitright
set pumheight=10
set signcolumn=yes
set updatetime=300
set timeoutlen=500
set scrolloff=10
set confirm
set nolist
set ruler

" -------------------------------------------------------------------
" Plugins
" -------------------------------------------------------------------
let s:plug_dir = expand("~/.vim/plugins")

function! GetRepoName(name)
  let l:split_name = split(a:name, "/")
  let l:name = l:split_name[-1]
  if l:name == "vim" || l:name == "nvim"
    let l:name = l:split_name[-2]
  endif
  return l:name
endfunction

function! GetPluginDirs()
  let l:dirs = glob(s:plug_dir . "/*", 0, 1)
  return filter(l:dirs, 'isdirectory(v:val)')
endfunction

function! s:plug_install(repo)
   let l:name = GetRepoName(a:repo)
   let l:path = s:plug_dir . "/" . l:name
   
   if !isdirectory(l:path)
    if !isdirectory(s:plug_dir)
      call mkdir(s:plug_dir, 'p')
    endif
    execute '!git clone --depth=1 ' . a:repo . ' ' . shellescape(l:path)
   endif

   execute 'set runtimepath+=' . fnameescape(l:path)
endfunction

function! s:plug_update()
  let l:plug_dirs = GetPluginDirs()
  for dir in l:plug_dirs
    if isdirectory(dir . "/.git")
      echo "Updating " . dir
      call system('git -C ' . shellescape(dir) . ' pull --ff-only')
    endif
  endfor
  echomsg 'Done.'
endfunction

command! PlugUpdate call s:plug_update()

" PLUGIN INSTALLATION HERE
call s:plug_install("https://github.com/catppuccin/vim")
call s:plug_install("https://github.com/ctrlpvim/ctrlp.vim")

